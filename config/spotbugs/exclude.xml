<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs exclusions. Every entry needs a reason and a review (listed in the STOP report). -->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!--
    P0 Step 4. DbAccount deliberately shares its Secret instance: Secret.clear() must zero the one
    char[] that every holder sees. A defensive copy would leave unzeroed password copies in memory.
  -->
  <Match>
    <Class name="edu.ums.platform.config.AppConfig$DbAccount"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
