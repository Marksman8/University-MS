<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  UMS Checkstyle rules (P0 Step 2). Formatting is owned by Spotless/google-java-format;
  these rules cover design constraints only. Every violation fails the build.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <!-- The only allowed broad catches are marked: // CHECKSTYLE:ALLOW-CATCH <reason>
         (facade boundary, transaction retry, documented best-effort paths). -->
    <module name="SuppressWithNearbyCommentFilter">
      <property name="commentFormat" value="CHECKSTYLE:ALLOW-CATCH \S.*"/>
      <property name="checkFormat" value="IllegalCatch"/>
      <property name="influenceFormat" value="1"/>
    </module>

    <module name="AvoidStarImport"/>

    <module name="MethodLength">
      <property name="max" value="60"/>
      <property name="countEmpty" value="false"/>
    </module>

    <module name="ParameterNumber">
      <property name="max" value="7"/>
      <property name="ignoreOverriddenMethods" value="true"/>
    </module>

    <module name="IllegalCatch">
      <property name="illegalClassNames"
                value="Exception, Throwable, RuntimeException, java.lang.Exception, java.lang.Throwable, java.lang.RuntimeException"/>
    </module>

    <module name="RegexpSinglelineJava">
      <property name="id" value="noSystemOut"/>
      <property name="format" value="System\s*\.\s*(out|err)\b"/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Use SLF4J logging, not System.out / System.err."/>
    </module>

    <module name="RegexpSinglelineJava">
      <property name="id" value="noPrintStackTrace"/>
      <property name="format" value="\.printStackTrace\s*\("/>
      <property name="ignoreComments" value="true"/>
      <property name="message" value="Log the exception with SLF4J instead of printStackTrace()."/>
    </module>

    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
  </module>
</module>
