<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging: console only, warnings and above; expected failures silenced. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <logger name="edu.ums.platform.error.ApiErrorTranslator" level="OFF"/>
  <logger name="edu.ums.platform.db.TransactionRunner" level="OFF"/>
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
